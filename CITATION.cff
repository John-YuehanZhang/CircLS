cff-version: 1.2.0
message: "If you use CircLS in your research, please cite it as below."
title: "CircLS"
authors:
  - family-names: "Zhang"
    given-names: "Yuehan"
license: Apache-2.0
repository-code: "https://github.com/John-YuehanZhang/CircLS"
abstract: >-
  CircLS compiles lattice-surgery programs from Clifford QASM or PPM
  sequences to verified physical (stim) circuits, with lifetime-aware
  compilation and a rule-based stabilizer construction.
# preferred-citation (the CircLS paper): to be added when the arXiv
# preprint is up.
references:
  - type: article
    title: "LightStim"
    url: "https://github.com/QuTone/LightStim"
    notes: "CircLS vendors and builds on the LightStim detector backend (arXiv:2604.21472)."
